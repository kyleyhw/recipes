# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- project additions (global standards §5) ---
# .env* above ignores every env file; the example template must be committed.
!.env.example

# python virtualenvs (standards §5 requires these ignored before first commit)
venv/
.venv/

# secrets-scanning audit artefacts
.secrets.baseline.tmp

# test + build artefacts
/coverage/
/test-results/
/playwright-report/

# local development database (PGlite)
.pglite/

# generated Prisma client (produced by `prisma generate` on postinstall)
/src/generated/
