// Prisma schema — recipe management application.
//
// Design notes are in docs/data-model.md; the mathematical roles of the
// nutrition fields (m_i, rho, mu) are derived in docs/mathematics.md.
//
// The whole schema is declared up front, including the models used only by
// later phases (Tag, AiInteraction), so that a single initial migration covers
// the entire application and no destructive migration is needed mid-build.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7 removed `url` from the datasource block. The connection string is
// supplied to the CLI via prisma.config.ts, and to the client at runtime via a
// driver adapter (src/lib/db.ts). Only the provider remains here.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enumerations
// ---------------------------------------------------------------------------

enum RecipeStatus {
  DRAFT // generated by Claude, not yet reviewed by the owner
  SAVED // trusted
  ARCHIVED // hidden from browse, retained
}

enum PhotoSource {
  SOURCE_PAGE // og:image from the recipe's own source URL (layer 1)
  WEB_SEARCH // Claude web search (layer 2)
  UPLOAD // owner-supplied (layer 3) — always wins over automatic results
  PLACEHOLDER // deterministic gradient (layer 4)
}

enum MacroSource {
  USDA // FoodData Central
  CLAUDE // model estimate, used only where USDA has no match
  MANUAL // owner override; never overwritten by an automatic pass
}

enum AiKind {
  SUBSTITUTE
  GENERATE
  IMPORT
  PHOTO
  MACRO_MATCH
}

// ---------------------------------------------------------------------------
// Core
// ---------------------------------------------------------------------------

model Category {
  id       String   @id @default(cuid())
  name     String   @unique
  slug     String   @unique
  /// Display order on the browse page. Explicit rather than alphabetical so
  /// that meal-shaped categories can precede component ones.
  position Int      @default(0)
  /// Single character rendered on the deterministic placeholder image.
  glyph    String   @default("*")
  recipes  Recipe[]

  @@index([position])
}

model Tag {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  recipes Recipe[]
}

model Recipe {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags       Tag[]

  /// S in docs/mathematics.md §2.3 — the serving count the stored quantities
  /// correspond to. Scaling is a view; this value is not mutated by it.
  baseServings Float  @default(4)
  /// Unit noun for a serving: "serving", "cookie", "slice". Affects only display.
  servingLabel String @default("serving")

  prepMinutes Int?
  cookMinutes Int?
  sourceUrl   String?
  notes       String?
  status      RecipeStatus @default(SAVED)

  // --- sharing (phase 6) ---
  /// Null until shared. Unguessable random id; revoking sharing nulls it, which
  /// immediately invalidates any circulated link.
  shareId      String?   @unique
  sharedAt     DateTime?
  /// { instanceUrl, shareId, title, importedAt } when imported from elsewhere.
  importedFrom Json?

  // --- photo (phase 3/7) ---
  photoUrl        String?
  photoSource     PhotoSource?
  /// { siteName, pageUrl, originalUrl, fetchedAt }
  photoCredit     Json?
  /// Runner-up candidates from the last search, so "replace photo" needs no
  /// second billable call.
  photoCandidates Json?

  ingredients RecipeIngredient[]
  steps       Step[]
  aiLog       AiInteraction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, status])
  @@index([updatedAt])
}

model RecipeIngredient {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  position Int

  /// The line exactly as entered or imported, e.g. "1 large onion, finely diced".
  /// Never discarded: parsing, resolution, and scaling are derived views over
  /// this string, so a failure in any of them still leaves a readable recipe.
  rawText String

  quantity Float?
  unit     String?
  name     String
  prepNote String?

  optional Boolean @default(false)
  /// False for quantities that must not be multiplied by alpha — "salt to
  /// taste", "oil for frying". See docs/mathematics.md §2.2.
  scalable Boolean @default(true)

  /// Null means unresolved: the ingredient contributes no macros AND is
  /// reported as a coverage gap. It is never treated as nutritionally zero.
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  /// Owner-supplied gram mass, bypassing unit conversion entirely. The escape
  /// hatch for cases where rho/mu are unknown or wrong.
  gramsOverride Float?

  @@unique([recipeId, position])
  @@index([ingredientId])
}

model Step {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  position Int
  text     String

  @@unique([recipeId, position])
}

/// Canonical ingredient, shared by every recipe that references it.
///
/// Sharing is the point: resolving "unsalted butter" against USDA once makes
/// every recipe using it accurate at once, and a manual correction propagates
/// everywhere rather than needing to be repeated per recipe.
model Ingredient {
  id        String  @id @default(cuid())
  name      String  @unique
  usdaFdcId String?

  // The per-100 g macro vector m_i of docs/mathematics.md §2.3.
  kcal100g     Float
  protein100g  Float
  carbs100g    Float
  fat100g      Float
  fiber100g    Float?
  sugar100g    Float?
  sodiumMg100g Float?

  /// rho — grams per millilitre, for volume -> mass. A property of the
  /// substance, not of the unit, which is why it lives here and not in units.ts.
  /// Null means volume measures of this ingredient cannot be converted, and the
  /// ingredient is reported as a coverage gap rather than given a default.
  densityGPerMl Float?
  /// mu — grams per countable item ("1 egg" = 50 g). Same rationale as rho.
  gramsPerUnit  Float?

  source     MacroSource @default(USDA)
  /// Free text recording where rho/mu/macros came from, so a suspicious number
  /// can be traced. Required by the magic-number standard (§4).
  sourceNote String?

  usedBy RecipeIngredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usdaFdcId])
}

// ---------------------------------------------------------------------------
// Operational
// ---------------------------------------------------------------------------

/// A standing instruction the owner wants applied to every generated or
/// adjusted recipe.
///
/// These are *preferences*, not recipe data: "I like strong flavours", "steps
/// must be unambiguous and direct". They are injected into every Claude prompt
/// (generation, substitution, import), so a preference is stated once and then
/// respected everywhere, rather than being retyped into each request.
///
/// Free text rather than structured fields, because the useful preferences are
/// not enumerable in advance and the consumer is a language model.
model Memory {
  id   String @id @default(cuid())
  text String

  /// Display and prompt order. Earlier memories appear first in the prompt.
  position Int @default(0)

  /// Built-in memories are seeded and cannot be deleted, only edited: they
  /// encode requirements the application depends on (unambiguous steps) rather
  /// than mere taste.
  builtIn Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

/// Audit trail and cost visibility for billable model calls. Exists so the
/// monthly spend ceiling can be enforced from recorded usage rather than from
/// an external dashboard.
model AiInteraction {
  id       String  @id @default(cuid())
  recipeId String?
  recipe   Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  kind  AiKind
  model String

  inputTokens       Int
  outputTokens      Int
  /// Cost snapshot in USD, priced at call time. Stored rather than recomputed
  /// because published prices change, which would silently rewrite history.
  costUsd           Float
  /// Server-side web search is billed per search, separately from tokens.
  webSearchRequests Int   @default(0)

  createdAt DateTime @default(now())

  @@index([createdAt])
}
