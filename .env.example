# Environment template. Copy to `.env` if you need any of it.
#
#   cp .env.example .env
#
# Nothing here is required to read, build or deploy the site. Every page is
# generated from files in `content/` at build time, and the published site holds
# no key of any kind — it could not, since it is a static site served from a
# public URL.

# --- Optional -----------------------------------------------------------------

# Used by `npm run translate`, and by nothing else.
#
# That script reads each recipe, asks Claude for it in each of the site's
# languages, and writes the result to content/recipes/<slug>.<language>.md. The
# output is committed like any other file, so the translation is generated once
# and served statically forever after — the key is needed on the machine that
# runs the script, never by a reader.
#
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# The repository the site links to for "read it", "edit it" and its history.
#
# Set automatically by .github/workflows/pages.yml from the repository being
# built. Set it locally only if you want those links to work in `npm run dev`.
NEXT_PUBLIC_REPO=""

# The path a project page is served from — "/recipes" for
# <user>.github.io/recipes. Set automatically by the workflow. Leave it empty
# for a user page or a custom domain, both of which are served from the root.
PAGES_BASE_PATH=""
