# Environment template. Copy to `.env` and fill in.
#
#   cp .env.example .env && npm run setup
#
# `npm run setup` prints SESSION_SECRET and OWNER_PASSWORD_HASH for you.
# See docs/self-hosting.md for the full walkthrough.

# --- Required -----------------------------------------------------------------

# PostgreSQL connection string. On Neon, use the *pooled* endpoint
# (host contains "-pooler"); serverless functions open many short-lived
# connections and will exhaust a direct endpoint's limit.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Cookie sealing key. At least 32 characters; `npm run setup` generates 64 hex
# characters (256 bits). Changing it invalidates every existing session.
SESSION_SECRET=""

# scrypt hash of the owner password, produced by `npm run setup`. Paste it
# verbatim, unquoted.
#
# The format is ':'-separated rather than the conventional '$'-separated
# modular-crypt form on purpose: Next.js runs dotenv-expand over .env files,
# which would read `$32768` as a variable reference and silently truncate the
# hash — producing "incorrect password" at every login with nothing to explain
# it. Do not convert it back to '$' separators.
OWNER_PASSWORD_HASH=""

# --- Optional -----------------------------------------------------------------
# Each key that is absent disables exactly one capability. A deployment with
# only the three required variables above is a fully working recipe box.

# Absent: every Claude feature hides itself (substitution, generation, text and
# URL import, web-search photo sourcing, ingredient matching).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Absent: macro lookup falls back to manual entry in the ingredient library.
# Free, issued instantly: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=""

# Absent: photos fall back to the generated placeholder. Vercel injects this
# automatically once a Blob store is attached to the project.
BLOB_READ_WRITE_TOKEN=""

# Monthly ceiling on model spend, in USD. Checked against recorded usage before
# any billable call; exceeding it disables AI features until the month rolls
# over. Defaults to 10 if unset.
AI_MONTHLY_BUDGET_USD="10"

# Maximum PostgreSQL connections in the pool. Defaults to 5, which suits a
# serverless deployment against a pooled endpoint. Set to 1 when developing
# against the bundled PGlite server (`npm run db:dev`), which accepts a single
# connection at a time and terminates the surplus.
DB_POOL_MAX="5"

# Public origin of this deployment, used to build share links and to stamp
# provenance on exported bundles. On Vercel this is inferred automatically;
# set it only to override (e.g. a custom domain).
APP_URL=""
